# ========================================================
# CREDENCIAIS DO EMISSOR NACIONAL (NFS-e)
# ========================================================
cnpj=00000000000000
senha=sua_senha_do_portal

# ========================================================
# RESOLUÇÃO AUTOMÁTICA DE CAPTCHA (hCaptcha)
# ========================================================
# 2Captcha (Recomendado - https://2captcha.com)
TWOCAPTCHA_API_KEY=

# CapSolver (https://www.capsolver.com)
CAPSOLVER_API_KEY=

# Anti-Captcha (https://anti-captcha.com)
ANTICAPTCHA_API_KEY=

# Gemini Vision (Fallback visual inteligente via Google AI Studio)
GEMINI_API_KEY=

# ========================================================
# DISPARO AUTOMÁTICO DE E-MAIL (GMAIL SMTP - NODEMAILER)
# ========================================================
# Gere uma senha de app em: https://myaccount.google.com/apppasswords
GMAIL_USER=seu_email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
EMAIL_FROM=seu_email@dominio.com.br
ADMIN_NOTIFY_EMAIL=seu_email_admin@gmail.com
